<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>MacOverlay</string>
    <key>CFBundleDisplayName</key>
    <string>Mac Overlay</string>
    <key>CFBundleIdentifier</key>
    <string>com.overlay.MacOverlay</string>
    <key>CFBundleVersion</key>
    <string>3.0</string>
    <key>CFBundleShortVersionString</key>
    <string>3.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>MacOverlay</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticTermination</key>
    <false/>
    <key>NSMicrophoneUsageDescription</key>
    <string>MacOverlay needs microphone access to transcribe your speech in real time.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>MacOverlay uses speech recognition to convert audio to text.</string>
    <!--
      Calendar permission strings deliberately omitted in v1. The Calendar
      feature is hidden behind FeatureFlags.calendarEnabled; without these
      keys, macOS will never prompt the user for calendar access on launch.
      Add them back when re-enabling Calendar in a future release:
        - NSCalendarsUsageDescription
        - NSCalendarsFullAccessUsageDescription
    -->
</dict>
</plist>
